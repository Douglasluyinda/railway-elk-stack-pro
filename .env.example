# LOCAL docker-compose use only. On Railway these are generated by the template
# (see TEMPLATE.md). Use letters and digits only; setup.sh rejects quotes and backslashes.
# Generate each value with:  openssl rand -hex 24
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
LOGSTASH_WRITER_PASSWORD=
INPUT_PASSWORD=
# At least 32 characters.
KIBANA_ENCRYPTION_KEY=
